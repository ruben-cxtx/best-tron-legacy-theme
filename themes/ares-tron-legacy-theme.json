  "tokenColors": [
    {
      "name": "Comments - subdued program notes",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#D08B92",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#FFC8CD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#FF6A3D"
      }
    },
    {
      "name": "Module boundaries",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.other.important"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#FFC8CD"
      }
    },
    {
      "name": "Functions and calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.builtin",
        "meta.function-call",
        "variable.function",
        "meta.method-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#FF4D6D"
      }
    },
    {
      "name": "React components and constructors",
      "scope": [
        "support.class.component",
        "entity.name.type.class.jsx",
        "entity.name.tag support.class.component",
        "variable.other.object.js",
        "variable.other.object.ts",
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#FF9A62"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#FFE4E6"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FF9A62"
      }
    },
    {
      "name": "Numbers and units",
      "scope": [
        "constant.numeric",
        "constant.numeric.css",
        "keyword.other.unit",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "source.js.embedded.expression",
        "source.ts.embedded.expression"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#FF2D45"
      }
    },
    {
      "name": "Types, classes, and interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.interface",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "Object properties and JSON keys",
      "scope": [
        "variable.object.property",
        "variable.other.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.object-literal.key",
        "meta.property.object",
        "entity.name.tag.yaml",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FFC8CD"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.name.function.decorator",
        "meta.function.decorator"
      ],
      "settings": {
        "foreground": "#FF2D45",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSX, Astro, HTML, and XML tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.tag.astro",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF4D6D"
      }
    },
    {
      "name": "JSX, Astro, HTML, and Tailwind attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name.astro",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#FFE066",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#FF4D6D"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#FFC8CD"
      }
    },
    {
      "name": "CSS values and Tailwind-like literals",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "SQL keywords and clauses",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.ddl.sql",
        "keyword.other.sql",
        "storage.type.sql",
        "support.function.aggregate.sql"
      ],
      "settings": {
        "foreground": "#FF6A3D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "SQL tables, columns, and symbols",
      "scope": [
        "entity.name.function.sql",
        "entity.name.type.sql",
        "support.type.sql",
        "meta.table.sql",
        "meta.column.sql"
      ],
      "settings": {
        "foreground": "#FF4D6D"
      }
    },
    {
      "name": "Python self, magic, and builtins",
      "scope": [
        "variable.language.special.self.python",
        "support.function.builtin.python",
        "support.type.python",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#FF9A62"
      }
    },
    {
      "name": "Shell, Dockerfile, and CI directives",
      "scope": [
        "support.function.builtin.shell",
        "support.function.builtin.zsh",
        "support.function.builtin.bash",
        "keyword.other.special-method.shell",
        "entity.name.function.shell",
        "keyword.other.Dockerfile",
        "keyword.other.special-method.dockerfile",
        "support.function.git-rebase"
      ],
      "settings": {
        "foreground": "#FF4D6D"
      }
    },
    {
      "name": "YAML, GitLab CI, Kubernetes, and Docker keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.yaml",
        "punctuation.separator.key-value.yaml",
        "constant.other.alias.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#FFC8CD"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#FF4D6D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links and references",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link",
        "meta.link.inline"
      ],
      "settings": {
        "foreground": "#FF6A3D"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FFC8CD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFE066",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code and fences",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block",
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#D08B92"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF2D45"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FF2D45",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#FF2D45",
    "type": "#FFE066",
    "type.defaultLibrary": "#FF9A62",
    "class": "#FFE066",
    "class.defaultLibrary": "#FF9A62",
    "enum": "#FFE066",
    "interface": "#FFE066",
    "struct": "#FFE066",
    "typeParameter": "#FF9A62",
    "parameter": "#FFC8CD",
    "variable": "#FFE4E6",
    "variable.readonly": "#FF9A62",
    "variable.defaultLibrary": "#FF9A62",
    "property": "#FFC8CD",
    "property.readonly": "#FF9A62",
    "enumMember": "#FF9A62",
    "event": "#FF2D45",
    "function": "#FF4D6D",
    "function.defaultLibrary": "#FF9A62",
    "method": "#FF4D6D",
    "method.defaultLibrary": "#FF9A62",
    "macro": "#FF2D45",
    "keyword": "#FF6A3D",
    "modifier": "#FF6A3D",
    "comment": {
      "foreground": "#D08B92",
      "italic": true
    },
    "string": "#FFD166",
    "number": "#FFE066",
    "regexp": "#FF2D45",
    "operator": "#FFC8CD",
    "decorator": {
      "foreground": "#FF2D45",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.static": {
      "foreground": "#FF9A62"
    },
    "*.async": {
      "foreground": "#FF4D6D",
      "italic": true
    },
    "*.deprecated": {
      "foreground": "#8E3D48",
      "underline": true
    },
    "variable.readonly:javascript": "#FF9A62",
    "variable.readonly:typescript": "#FF9A62",
    "property.readonly:javascript": "#FF9A62",
    "property.readonly:typescript": "#FF9A62",
    "function:python": "#FF4D6D",
    "parameter:python": "#FFC8CD",
    "class:python": "#FFE066"
  }
}
