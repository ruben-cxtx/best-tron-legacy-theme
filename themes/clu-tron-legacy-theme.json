  "tokenColors": [
    {
      "name": "Comments - subdued program notes",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#C59055",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#FFD99C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#FF6A00"
      }
    },
    {
      "name": "Module boundaries",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.other.important"
      ],
      "settings": {
        "foreground": "#FFE08A"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#FFD99C"
      }
    },
    {
      "name": "Functions and calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.builtin",
        "meta.function-call",
        "variable.function",
        "meta.method-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#FFB020"
      }
    },
    {
      "name": "React components and constructors",
      "scope": [
        "support.class.component",
        "entity.name.type.class.jsx",
        "entity.name.tag support.class.component",
        "variable.other.object.js",
        "variable.other.object.ts",
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#FFE8C1"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "Numbers and units",
      "scope": [
        "constant.numeric",
        "constant.numeric.css",
        "keyword.other.unit",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#FFE08A"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "source.js.embedded.expression",
        "source.ts.embedded.expression"
      ],
      "settings": {
        "foreground": "#FFE08A"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#FF5A1F"
      }
    },
    {
      "name": "Types, classes, and interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.interface",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#FFE08A"
      }
    },
    {
      "name": "Object properties and JSON keys",
      "scope": [
        "variable.object.property",
        "variable.other.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.object-literal.key",
        "meta.property.object",
        "entity.name.tag.yaml",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FFD99C"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.name.function.decorator",
        "meta.function.decorator"
      ],
      "settings": {
        "foreground": "#FF5A1F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSX, Astro, HTML, and XML tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.tag.astro",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FFB020"
      }
    },
    {
      "name": "JSX, Astro, HTML, and Tailwind attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name.astro",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#FFE08A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#FFB020"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#FFD99C"
      }
    },
    {
      "name": "CSS values and Tailwind-like literals",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "SQL keywords and clauses",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.ddl.sql",
        "keyword.other.sql",
        "storage.type.sql",
        "support.function.aggregate.sql"
      ],
      "settings": {
        "foreground": "#FF6A00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "SQL tables, columns, and symbols",
      "scope": [
        "entity.name.function.sql",
        "entity.name.type.sql",
        "support.type.sql",
        "meta.table.sql",
        "meta.column.sql"
      ],
      "settings": {
        "foreground": "#FFB020"
      }
    },
    {
      "name": "Python self, magic, and builtins",
      "scope": [
        "variable.language.special.self.python",
        "support.function.builtin.python",
        "support.type.python",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#FFCB6B"
      }
    },
    {
      "name": "Shell, Dockerfile, and CI directives",
      "scope": [
        "support.function.builtin.shell",
        "support.function.builtin.zsh",
        "support.function.builtin.bash",
        "keyword.other.special-method.shell",
        "entity.name.function.shell",
        "keyword.other.Dockerfile",
        "keyword.other.special-method.dockerfile",
        "support.function.git-rebase"
      ],
      "settings": {
        "foreground": "#FFB020"
      }
    },
    {
      "name": "YAML, GitLab CI, Kubernetes, and Docker keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.yaml",
        "punctuation.separator.key-value.yaml",
        "constant.other.alias.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#FFD99C"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#FFB020",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links and references",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link",
        "meta.link.inline"
      ],
      "settings": {
        "foreground": "#FF6A00"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FFD99C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFE08A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code and fences",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block",
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#C59055"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF5A1F"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFE08A"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FF5A1F",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#FE9C00",
    "type": "#FFE08A",
    "type.defaultLibrary": "#FFCB6B",
    "class": "#FFE08A",
    "class.defaultLibrary": "#FFCB6B",
    "enum": "#FFE08A",
    "interface": "#FFE08A",
    "struct": "#FFE08A",
    "typeParameter": "#FFCB6B",
    "parameter": "#FFD99C",
    "variable": "#FFE8C1",
    "variable.readonly": "#FFCB6B",
    "variable.defaultLibrary": "#FFCB6B",
    "property": "#FFD99C",
    "property.readonly": "#FFCB6B",
    "enumMember": "#FFCB6B",
    "event": "#FF5A1F",
    "function": "#FFB020",
    "function.defaultLibrary": "#FFCB6B",
    "method": "#FFB020",
    "method.defaultLibrary": "#FFCB6B",
    "macro": "#FF5A1F",
    "keyword": "#FF6A00",
    "modifier": "#FF6A00",
    "comment": {
      "foreground": "#C59055",
      "italic": true
    },
    "string": "#FFFFFF",
    "number": "#FFE08A",
    "regexp": "#FF5A1F",
    "operator": "#FFD99C",
    "decorator": {
      "foreground": "#FF5A1F",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.static": {
      "foreground": "#FFCB6B"
    },
    "*.async": {
      "foreground": "#FFB020",
      "italic": true
    },
    "*.deprecated": {
      "foreground": "#80623B",
      "underline": true
    },
    "variable.readonly:javascript": "#FFCB6B",
    "variable.readonly:typescript": "#FFCB6B",
    "property.readonly:javascript": "#FFCB6B",
    "property.readonly:typescript": "#FFCB6B",
    "function:python": "#FFB020",
    "parameter:python": "#FFD99C",
    "class:python": "#FFE08A"
  }
