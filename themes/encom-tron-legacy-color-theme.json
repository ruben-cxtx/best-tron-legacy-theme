  "tokenColors": [
    {
      "name": "Comments - subdued program notes",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6DA9B8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A9E6F0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#2D7DFF"
      }
    },
    {
      "name": "Module boundaries",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.other.important"
      ],
      "settings": {
        "foreground": "#FFC777"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#A9E6F0"
      }
    },
    {
      "name": "Functions and calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.builtin",
        "meta.function-call",
        "variable.function",
        "meta.method-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#00F5FF"
      }
    },
    {
      "name": "React components and constructors",
      "scope": [
        "support.class.component",
        "entity.name.type.class.jsx",
        "entity.name.tag support.class.component",
        "variable.other.object.js",
        "variable.other.object.ts",
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#B7A7FF"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#D8FBFF"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#B7A7FF"
      }
    },
    {
      "name": "Numbers and units",
      "scope": [
        "constant.numeric",
        "constant.numeric.css",
        "keyword.other.unit",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#FFC777"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#8DFFB3"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "source.js.embedded.expression",
        "source.ts.embedded.expression"
      ],
      "settings": {
        "foreground": "#FFC777"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#FF6E7A"
      }
    },
    {
      "name": "Types, classes, and interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.interface",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#FFC777"
      }
    },
    {
      "name": "Object properties and JSON keys",
      "scope": [
        "variable.object.property",
        "variable.other.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.object-literal.key",
        "meta.property.object",
        "entity.name.tag.yaml",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#A9E6F0"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.name.function.decorator",
        "meta.function.decorator"
      ],
      "settings": {
        "foreground": "#FF6E7A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSX, Astro, HTML, and XML tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.tag.astro",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00F5FF"
      }
    },
    {
      "name": "JSX, Astro, HTML, and Tailwind attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name.astro",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#FFC777",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#00F5FF"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#A9E6F0"
      }
    },
    {
      "name": "CSS values and Tailwind-like literals",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#8DFFB3"
      }
    },
    {
      "name": "SQL keywords and clauses",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.ddl.sql",
        "keyword.other.sql",
        "storage.type.sql",
        "support.function.aggregate.sql"
      ],
      "settings": {
        "foreground": "#2D7DFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "SQL tables, columns, and symbols",
      "scope": [
        "entity.name.function.sql",
        "entity.name.type.sql",
        "support.type.sql",
        "meta.table.sql",
        "meta.column.sql"
      ],
      "settings": {
        "foreground": "#00F5FF"
      }
    },
    {
      "name": "Python self, magic, and builtins",
      "scope": [
        "variable.language.special.self.python",
        "support.function.builtin.python",
        "support.type.python",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#B7A7FF"
      }
    },
    {
      "name": "Shell, Dockerfile, and CI directives",
      "scope": [
        "support.function.builtin.shell",
        "support.function.builtin.zsh",
        "support.function.builtin.bash",
        "keyword.other.special-method.shell",
        "entity.name.function.shell",
        "keyword.other.Dockerfile",
        "keyword.other.special-method.dockerfile",
        "support.function.git-rebase"
      ],
      "settings": {
        "foreground": "#00F5FF"
      }
    },
    {
      "name": "YAML, GitLab CI, Kubernetes, and Docker keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.yaml",
        "punctuation.separator.key-value.yaml",
        "constant.other.alias.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#A9E6F0"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#00F5FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links and references",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link",
        "meta.link.inline"
      ],
      "settings": {
        "foreground": "#2D7DFF"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#A9E6F0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFC777",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code and fences",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block",
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#8DFFB3"
      }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#6DA9B8"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8DFFB3"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF6E7A"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFC777"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FF6E7A",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#6FC3DF",
    "type": "#FFC777",
    "type.defaultLibrary": "#B7A7FF",
    "class": "#FFC777",
    "class.defaultLibrary": "#B7A7FF",
    "enum": "#FFC777",
    "interface": "#FFC777",
    "struct": "#FFC777",
    "typeParameter": "#B7A7FF",
    "parameter": "#A9E6F0",
    "variable": "#D8FBFF",
    "variable.readonly": "#B7A7FF",
    "variable.defaultLibrary": "#B7A7FF",
    "property": "#A9E6F0",
    "property.readonly": "#B7A7FF",
    "enumMember": "#B7A7FF",
    "event": "#FF6E7A",
    "function": "#00F5FF",
    "function.defaultLibrary": "#B7A7FF",
    "method": "#00F5FF",
    "method.defaultLibrary": "#B7A7FF",
    "macro": "#FF6E7A",
    "keyword": "#2D7DFF",
    "modifier": "#2D7DFF",
    "comment": {
      "foreground": "#6DA9B8",
      "italic": true
    },
    "string": "#8DFFB3",
    "number": "#FFC777",
    "regexp": "#FF6E7A",
    "operator": "#A9E6F0",
    "decorator": {
      "foreground": "#FF6E7A",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.static": {
      "foreground": "#B7A7FF"
    },
    "*.async": {
      "foreground": "#00F5FF",
      "italic": true
    },
    "*.deprecated": {
      "foreground": "#3E7482",
      "underline": true
    },
    "variable.readonly:javascript": "#B7A7FF",
    "variable.readonly:typescript": "#B7A7FF",
    "property.readonly:javascript": "#B7A7FF",
    "property.readonly:typescript": "#B7A7FF",
    "function:python": "#00F5FF",
    "parameter:python": "#A9E6F0",
    "class:python": "#FFC777"
  }
