  "tokenColors": [
    {
      "name": "Comments - subdued program notes",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6AA7C8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A9E9FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage.modifier",
        "storage.type"
      ],
      "settings": {
        "foreground": "#FF2BD6"
      }
    },
    {
      "name": "Module boundaries",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as",
        "keyword.other.important"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#A9E9FF"
      }
    },
    {
      "name": "Functions and calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.builtin",
        "meta.function-call",
        "variable.function",
        "meta.method-call",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "React components and constructors",
      "scope": [
        "support.class.component",
        "entity.name.type.class.jsx",
        "entity.name.tag support.class.component",
        "variable.other.object.js",
        "variable.other.object.ts",
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#39FF14"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "support.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#DDF7FF"
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#39FF14"
      }
    },
    {
      "name": "Numbers and units",
      "scope": [
        "constant.numeric",
        "constant.numeric.css",
        "keyword.other.unit",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "String escapes and interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "source.js.embedded.expression",
        "source.ts.embedded.expression"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#FF3B6B"
      }
    },
    {
      "name": "Types, classes, and interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.interface",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "Object properties and JSON keys",
      "scope": [
        "variable.object.property",
        "variable.other.property",
        "support.type.property-name",
        "support.type.property-name.json",
        "meta.object-literal.key",
        "meta.property.object",
        "entity.name.tag.yaml",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#A9E9FF"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.name.function.decorator",
        "meta.function.decorator"
      ],
      "settings": {
        "foreground": "#FF3B6B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSX, Astro, HTML, and XML tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx",
        "entity.name.tag.astro",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "JSX, Astro, HTML, and Tailwind attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name.astro",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#FFB000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#A9E9FF"
      }
    },
    {
      "name": "CSS values and Tailwind-like literals",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "SQL keywords and clauses",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.ddl.sql",
        "keyword.other.sql",
        "storage.type.sql",
        "support.function.aggregate.sql"
      ],
      "settings": {
        "foreground": "#FF2BD6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "SQL tables, columns, and symbols",
      "scope": [
        "entity.name.function.sql",
        "entity.name.type.sql",
        "support.type.sql",
        "meta.table.sql",
        "meta.column.sql"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "Python self, magic, and builtins",
      "scope": [
        "variable.language.special.self.python",
        "support.function.builtin.python",
        "support.type.python",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#39FF14"
      }
    },
    {
      "name": "Shell, Dockerfile, and CI directives",
      "scope": [
        "support.function.builtin.shell",
        "support.function.builtin.zsh",
        "support.function.builtin.bash",
        "keyword.other.special-method.shell",
        "entity.name.function.shell",
        "keyword.other.Dockerfile",
        "keyword.other.special-method.dockerfile",
        "support.function.git-rebase"
      ],
      "settings": {
        "foreground": "#00F0FF"
      }
    },
    {
      "name": "YAML, GitLab CI, Kubernetes, and Docker keys",
      "scope": [
        "entity.name.tag.yaml",
        "support.type.property-name.yaml",
        "punctuation.separator.key-value.yaml",
        "constant.other.alias.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#A9E9FF"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#00F0FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links and references",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.other.reference.link",
        "meta.link.inline"
      ],
      "settings": {
        "foreground": "#FF2BD6"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#A9E9FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFB000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code and fences",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block",
        "punctuation.definition.raw.markdown"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#6AA7C8"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#FFE066"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF3B6B"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FF3B6B",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#00A3FF",
    "type": "#FFB000",
    "type.defaultLibrary": "#39FF14",
    "class": "#FFB000",
    "class.defaultLibrary": "#39FF14",
    "enum": "#FFB000",
    "interface": "#FFB000",
    "struct": "#FFB000",
    "typeParameter": "#39FF14",
    "parameter": "#A9E9FF",
    "variable": "#DDF7FF",
    "variable.readonly": "#39FF14",
    "variable.defaultLibrary": "#39FF14",
    "property": "#A9E9FF",
    "property.readonly": "#39FF14",
    "enumMember": "#39FF14",
    "event": "#FF3B6B",
    "function": "#00F0FF",
    "function.defaultLibrary": "#39FF14",
    "method": "#00F0FF",
    "method.defaultLibrary": "#39FF14",
    "macro": "#FF3B6B",
    "keyword": "#FF2BD6",
    "modifier": "#FF2BD6",
    "comment": {
      "foreground": "#6AA7C8",
      "italic": true
    },
    "string": "#FFE066",
    "number": "#FFB000",
    "regexp": "#FF3B6B",
    "operator": "#A9E9FF",
    "decorator": {
      "foreground": "#FF3B6B",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.static": {
      "foreground": "#39FF14"
    },
    "*.async": {
      "foreground": "#00F0FF",
      "italic": true
    },
    "*.deprecated": {
      "foreground": "#3C6D88",
      "underline": true
    },
    "variable.readonly:javascript": "#39FF14",
    "variable.readonly:typescript": "#39FF14",
    "property.readonly:javascript": "#39FF14",
    "property.readonly:typescript": "#39FF14",
    "function:python": "#00F0FF",
    "parameter:python": "#A9E9FF",
    "class:python": "#FFB000"
  }
}
